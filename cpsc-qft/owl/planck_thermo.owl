@prefix : <http://example.org/planck_thermo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix swrl: <http://www.w3.org/2003/11/swrl#> .
@prefix swrlb: <http://www.w3.org/2003/11/swrlb#> .

:ThermodynamicState a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty :hasTemperature ; owl:someValuesFrom xsd:double ] .

:QuantumRegime a owl:Class ;
    rdfs:subClassOf :ThermodynamicState ,
        [ a owl:Restriction ; owl:onProperty :hasWavelength ; owl:someValuesFrom xsd:double ] .

:BlackHoleRegime a owl:Class ;
    rdfs:subClassOf :ThermodynamicState ,
        [ a owl:Restriction ; owl:onProperty :hasSchwarzschildRadius ; owl:someValuesFrom xsd:double ] .

:hasTemperature a owl:DatatypeProperty ; rdfs:domain :ThermodynamicState ; rdfs:range xsd:double .
:hasEnergy a owl:DatatypeProperty ; rdfs:domain :ThermodynamicState ; rdfs:range xsd:double .
:hasWavelength a owl:DatatypeProperty ; rdfs:domain :QuantumRegime ; rdfs:range xsd:double .
:hasSchwarzschildRadius a owl:DatatypeProperty ; rdfs:domain :BlackHoleRegime ; rdfs:range xsd:double .

:k_B a owl:NamedIndividual ; :hasValue "1.380649e-23"^^xsd:double .
:hbar a owl:NamedIndividual ; :hasValue "1.054571817e-34"^^xsd:double .
:c a owl:NamedIndividual ; :hasValue "299792458"^^xsd:double .
:G a owl:NamedIndividual ; :hasValue "6.67430e-11"^^xsd:double .

[Rule1: 
  swrl:head ([ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :hasEnergy ; swrl:argument1 ?x ; swrl:argument2 ?E ])
  swrl:body (
    [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :hasTemperature ; swrl:argument1 ?x ; swrl:argument2 ?T ]
    [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate swrlb:multiply ; swrl:arguments (?E ?T ?k_B) ]
  )
] .

[Rule2: 
  swrl:head ([ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :hasSchwarzschildRadius ; swrl:argument1 ?x ; swrl:argument2 ?rs ])
  swrl:body (
    [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :hasEnergy ; swrl:argument1 ?x ; swrl:argument2 ?E ]
    [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate swrlb:multiply ; swrl:arguments (?num 2.0 ?G) ]
    [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate swrlb:multiply ; swrl:arguments (?den ?E ?c4) ]
    [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate swrlb:divide ; swrl:arguments (?rs ?num ?den) ]
  )
] .

[Rule3: 
  swrl:head ([ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :hasWavelength ; swrl:argument1 ?x ; swrl:argument2 ?wl ])
  swrl:body (
    [ a swrl:IndividualPropertyAtom ; swrl:propertyPredicate :hasEnergy ; swrl:argument1 ?x ; swrl:argument2 ?E ]
    [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate swrlb:multiply ; swrl:arguments (?num ?hbar ?c) ]
    [ a swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate swrlb:divide ; swrl:arguments (?wl ?num ?E) ]
  )
] .

:CollapseCondition a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf ( :QuantumRegime
            [ a owl:Restriction ; owl:onProperty :hasWavelength ; owl:someValuesFrom 
                [ a rdfs:Datatype ; owl:onDatatype xsd:double ; owl:withRestrictions ([ xsd:maxInclusive ?rs ]) ] ] ) ] .

[ a owl:AllDisjointClasses ; owl:members ( :ThermodynamicState :CollapseCondition ) ] .
